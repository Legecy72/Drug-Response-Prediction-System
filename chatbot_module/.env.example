# ============================================
# Drug Response Prediction System - Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ============================================
# CHATBOT-SPECIFIC VARIABLES (REQUIRED)
# ============================================

# Gemini API Key (required for chatbot AI functionality)
# Get your API key from: https://aistudio.google.com/app/apikey
# IMPORTANT: Replace the placeholder below with your actual API key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (optional, defaults to gemini-2.5-flash)
# Available options: gemini-2.5-flash, gemini-2.0-flash, gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# ============================================
# API SERVER VARIABLES (OPTIONAL)
# ============================================

# API Settings (optional, defaults shown)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
API_LOG_LEVEL=info

# ML Model Settings (optional)
DEFAULT_MODEL=CatBoost

# CORS Settings (optional)
# For production, restrict to your frontend domain:
# CORS_ORIGINS=https://your-app.com,https://staging.your-app.com
CORS_ORIGINS=*