REGRESSION_MODEL_NAME=lightgbm
CLASSIFICATION_MODEL_NAME=xgboost
CORS_ORIGINS=*

# Optional Gemini chatbot settings.
# Put your own key in .env. Do not commit real API keys.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=True
API_LOG_LEVEL=info
